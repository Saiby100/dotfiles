ex ()
{
	if [ -f $1 ] ; then
		case $1 in
			*.tar.bz2)	tar xjf $1	;;
			*.tar.gz)	tar xzf $1	;;
			*.bz2)		bunzip2 $1	;;
			*.rar)		unrar x $1	;;
			*.gz)		gunzip  $1	;;
			*.tar)		tar xf 	$1	;;
			*.tbz2)		tar xjf $1	;;
			*.tgz)		tar xzf $1	;;
			*.zip)		unzip	$1	;;
			*.Z)		uncompress $1;;
			*7z)		7z x	$1	;;
			*)			echo "'$1' cannot be extracted via ex()" ;;
		esac
	else
		echo "'$1' is not a valid file"
	fi
}

# Shortened
alias ll='ls -lah'
alias la='ls -a'
alias py='python3'
alias ref='source $HOME/.config/zsh/.zshrc'

alias rn='mv $1 $2'
alias cc='claude'
alias lg='lazygit'

# Attach to the last-used tmux session, or start one named Workspace if there
# is none. Nothing starts tmux automatically any more — this is the entry point.
alias t='tmux attach || tmux new-session -s Workspace'

# Bare `tmux` lands in Workspace too, instead of a new session named 0, 1, …
# -A attaches when Workspace already exists. Anything with arguments passes
# straight through.
tmux() {
  if [ $# -eq 0 ]; then
    command tmux new-session -A -s Workspace
  else
    command tmux "$@"
  fi
}

